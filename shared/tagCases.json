{
  "normalizeTags": [
    {
      "name": "primary plus extras",
      "primary": "food",
      "extras": ["zomato", "online food ordering"],
      "expected": {
        "tags": ["food", "zomato", "online food ordering"],
        "dropped": []
      }
    },
    {
      "name": "trim and collapse extra whitespace and lowercase extras",
      "primary": "  Food  ",
      "extras": ["  Online   Food  Ordering "],
      "expected": {
        "tags": ["Food", "online food ordering"],
        "dropped": []
      }
    },
    {
      "name": "canonical primary from tag lists",
      "primary": "FOOD",
      "extras": ["Zomato"],
      "opts": {
        "tagList": ["food", "rent"],
        "legacyTagList": ["tech"]
      },
      "expected": {
        "tags": ["food", "zomato"],
        "dropped": []
      }
    },
    {
      "name": "canonical primary from legacy list",
      "primary": "Tech",
      "extras": [],
      "opts": {
        "tagList": ["food"],
        "legacyTagList": ["tech"]
      },
      "expected": {
        "tags": ["tech"],
        "dropped": []
      }
    },
    {
      "name": "drop empty extras",
      "primary": "food",
      "extras": ["", "  ", "zomato"],
      "expected": {
        "tags": ["food", "zomato"],
        "dropped": ["", "  "]
      }
    },
    {
      "name": "dedupe extras against primary and each other",
      "primary": "food",
      "extras": ["Food", "zomato", "ZOMATO", "food"],
      "expected": {
        "tags": ["food", "zomato"],
        "dropped": ["Food", "ZOMATO", "food"]
      }
    },
    {
      "name": "cap at 8 tags total",
      "primary": "food",
      "extras": ["a", "b", "c", "d", "e", "f", "g", "h", "i"],
      "expected": {
        "tags": ["food", "a", "b", "c", "d", "e", "f", "g"],
        "dropped": ["h", "i"]
      }
    },
    {
      "name": "truncate extra length",
      "primary": "food",
      "extras": ["abcdefghijklmnopqrstuvwxyz0123456789EXTRA"],
      "expected": {
        "tags": ["food", "abcdefghijklmnopqrstuvwxyz0123456789extr"],
        "dropped": []
      }
    },
    {
      "name": "extras without primary are dropped",
      "primary": "",
      "extras": ["zomato", "online"],
      "expected": {
        "tags": [],
        "dropped": ["zomato", "online"]
      }
    },
    {
      "name": "null primary drops extras",
      "primary": null,
      "extras": ["zomato"],
      "expected": {
        "tags": [],
        "dropped": ["zomato"]
      }
    },
    {
      "name": "untagged primary is treated as none",
      "primary": "Untagged",
      "extras": ["zomato"],
      "expected": {
        "tags": [],
        "dropped": ["zomato"]
      }
    },
    {
      "name": "truncate a 50-character primary",
      "primary": "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMN",
      "extras": [],
      "expected": {
        "tags": ["abcdefghijklmnopqrstuvwxyz0123456789ABCD"],
        "dropped": []
      }
    },
    {
      "name": "cap 10 extras at 8 tags total",
      "primary": "food",
      "extras": ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"],
      "expected": {
        "tags": ["food", "a", "b", "c", "d", "e", "f", "g"],
        "dropped": ["h", "i", "j"]
      }
    },
    {
      "name": "extra equal to primary in a different case is dropped",
      "primary": "Food",
      "extras": ["FOOD"],
      "expected": {
        "tags": ["Food"],
        "dropped": ["FOOD"]
      }
    },
    {
      "name": "keeps an unlisted primary as written",
      "primary": "Mystery Shop",
      "extras": [],
      "opts": {
        "tagList": ["food"],
        "legacyTagList": []
      },
      "expected": {
        "tags": ["Mystery Shop"],
        "dropped": []
      }
    },
    {
      "name": "canonicalises a listed primary from spaced mixed case",
      "primary": " Food ",
      "extras": [],
      "opts": {
        "tagList": ["food"],
        "legacyTagList": []
      },
      "expected": {
        "tags": ["food"],
        "dropped": []
      }
    }
  ],
  "readTags": [
    {
      "name": "non-empty tags array wins over conflicting tag",
      "doc": {
        "tags": ["food", "zomato"],
        "tag": "rent"
      },
      "expected": ["food", "zomato"]
    },
    {
      "name": "string tag when tags missing",
      "doc": {
        "tag": "food"
      },
      "expected": ["food"]
    },
    {
      "name": "string tag when tags is empty array",
      "doc": {
        "tags": [],
        "tag": "food"
      },
      "expected": ["food"]
    },
    {
      "name": "null tag",
      "doc": {
        "tag": null
      },
      "expected": []
    },
    {
      "name": "missing fields",
      "doc": {},
      "expected": []
    },
    {
      "name": "untagged string",
      "doc": {
        "tag": "untagged"
      },
      "expected": []
    },
    {
      "name": "whitespace only tag",
      "doc": {
        "tag": "   "
      },
      "expected": []
    },
    {
      "name": "dirty tags array is normalised",
      "doc": {
        "tags": [" Food ", "food", "X"]
      },
      "expected": ["Food", "x"]
    },
    {
      "name": "untagged primary in tags array drops extras",
      "doc": {
        "tags": ["untagged", "x"]
      },
      "expected": []
    },
    {
      "name": "null primary in tags array drops extras",
      "doc": {
        "tags": [null, "x"]
      },
      "expected": []
    },
    {
      "name": "non-array tags falls through to tag string",
      "doc": {
        "tags": "ignored",
        "tag": "food"
      },
      "expected": ["food"]
    },
    {
      "name": "empty tags array uses tag string",
      "doc": {
        "tags": [],
        "tag": "food"
      },
      "expected": ["food"]
    },
    {
      "name": "LLM-written unlisted primary and extras",
      "doc": {
        "tags": ["Mystery Shop", "zomato"]
      },
      "expected": ["Mystery Shop", "zomato"]
    }
  ],
  "description": [
    {
      "name": "trim",
      "input": "  rare note  ",
      "expected": "rare note"
    },
    {
      "name": "empty omitted",
      "input": "   ",
      "expected": null
    },
    {
      "name": "empty string omitted",
      "input": "",
      "expected": null
    },
    {
      "name": "null omitted",
      "input": null,
      "expected": null
    },
    {
      "name": "truncate at 280",
      "input": "x",
      "repeat": 300,
      "expectedLength": 280
    },
    {
      "name": "number omitted",
      "input": 12,
      "expected": null
    },
    {
      "name": "object omitted",
      "input": {"text": "nope"},
      "expected": null
    }
  ],
  "tagListStatus": [
    {
      "name": "active in tagList",
      "tag": "food",
      "tagList": ["food"],
      "legacyTagList": [],
      "expected": "active"
    },
    {
      "name": "retired in legacy case insensitive",
      "tag": "Tech",
      "tagList": ["food"],
      "legacyTagList": ["tech"],
      "expected": "retired"
    },
    {
      "name": "unlisted mystery",
      "tag": "mystery",
      "tagList": ["food"],
      "legacyTagList": ["tech"],
      "expected": "unlisted"
    },
    {
      "name": "case-insensitive listed match",
      "tag": " FOOD ",
      "tagList": ["food"],
      "legacyTagList": [],
      "expected": "active"
    },
    {
      "name": "empty is null",
      "tag": "  ",
      "tagList": ["food"],
      "legacyTagList": [],
      "expected": null
    },
    {
      "name": "untagged is null",
      "tag": "untagged",
      "tagList": ["food"],
      "legacyTagList": [],
      "expected": null
    }
  ],
  "sameTag": [
    {
      "name": "mixed case matches",
      "left": "Food",
      "right": "food",
      "expected": true
    },
    {
      "name": "different tags",
      "left": "food",
      "right": "rent",
      "expected": false
    }
  ]
}
